# Database Connection
# If left unset or set to empty, the app will automatically use an embedded local database in .data/local-db
# To connect to an external PostgreSQL database (e.g. Supabase, Neon, Docker, or local Postgres):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_management

# API Server Port (Default is 5001 to prevent macOS AirPlay conflicts on port 5000)
PORT=5001

# Web Portal Frontend Port (Default: 5173)
# WEB_PORT=5173

# API Server URL for frontend proxying (Default: http://localhost:5001)
API_SERVER_URL=http://localhost:5001
